{
    // WUU2-CLI workspace settings.
    //
    // This repo is the console/PowerShell edition. It is a SEPARATE GIT REPOSITORY from the GUI
    // edition (dazzo31/WUU2) which sits alongside it at ..\WUU2 - the two share history but have
    // diverged, so open the one you intend to work on as its own workspace rather than mixing
    // them in one multi-root window. Mixing them makes it easy to commit a change to the wrong
    // repo, and their release validation and test suites are not interchangeable.
    "files.encoding": "utf8",
    "files.eol": "\r\n",

    // The release validator enforces a UTF-8 BOM on every shipped PowerShell file that contains
    // non-ASCII bytes. PS7's Set-Content -Encoding UTF8 writes BOM-LESS, and PowerShell 5.1 then
    // reads the file as ANSI - a multi-byte character eats a quote and the parse error appears far
    // away from the cause. This has broken this project three times, so it is gated byte-level in
    // Validate-Release.ps1.
    //
    // THE SETTING THAT MATTERS IS IN [powershell] BELOW, NOT THE "utf8" ABOVE. In VS Code,
    // "utf8" means WITHOUT a BOM - so the top-level value cannot satisfy the requirement, and an
    // earlier revision of these settings claimed it did. "utf8bom" is the value that writes a BOM.
    // The top-level entry is kept for non-PowerShell files (markdown, JSON), where a BOM is neither
    // needed nor wanted; PowerShell files are covered by the language-scoped override.
    "powershell.scriptAnalysis.enable": true,
    "powershell.codeFormatting.preset": "OTBS",

    // Markdown and PowerShell only - there is no build system, no package manager, no JS toolchain.
    "files.exclude": {
        "dist/": true
    },
    "search.exclude": {
        "dist/": true
    },

    // The GUI edition's backups and packaged output must never be treated as current behaviour.
    "files.associations": {
        "*.psm1": "powershell",
        "*.ps1": "powershell"
    },
    "[powershell]": {
        // MUST be utf8bom, not utf8: VS Code reads "utf8" as "without BOM", and a BOM-less save of
        // a file containing non-ASCII bytes is read as ANSI by PowerShell 5.1 (see the note above).
        // Scoped to the language rather than set globally so markdown/JSON files stay BOM-free.
        "files.encoding": "utf8bom",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [100]
    }
}
